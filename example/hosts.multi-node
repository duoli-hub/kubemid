[docker]
192.168.1.1
192.168.1.2
192.168.1.3

# master node(s), set unique 'mid_nodename' for each node
# CAUTION: 'mid_nodename' must consist of lower case alphanumeric characters, '-' or '.',
# and must start and end with an alphanumeric character
[mysql_master]
192.168.1.1 mid_nodename='master-01'
192.168.1.2 mid_nodename='master-02'
192.168.1.3 mid_nodename='master-03'

# work node(s), set unique 'mid_nodename' for each node
# CAUTION: 'mid_nodename' must consist of lower case alphanumeric characters, '-' or '.',
# and must start and end with an alphanumeric character
[mysql_node]
192.168.1.4 mid_nodename='worker-01'
192.168.1.5 mid_nodename='worker-02'

# [optional] ntp server
[chrony]
#192.168.1.1

[all:vars]
# --------- Main Variables ---------------
# container-runtime supported: docker, containerd
CONTAINER_RUNTIME="containerd"

# -------- Additional Variables (don't change the default value right now)---
# Binaries Directory
bin_dir="/opt/kube/bin"

# Deploy Directory (kubemid workspace)
base_dir="/etc/kubemid"

# Default python interpreter
ansible_python_interpreter=/usr/bin/python3
